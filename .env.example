# Copy to .env.local and fill in. .env.local is git-ignored.
#
# RULE: anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Secrets (API keys, service-role key) must NEVER have that prefix.

# --- LLM (Phase 2) — server only ---
ANTHROPIC_API_KEY=
# Model IDs and prices verified against Anthropic docs 2026-09-24 (lib/llm/pricing.ts).
MODEL_MAIN=claude-sonnet-5
MODEL_JUDGE=claude-haiku-4-5

# --- Supabase (Phase 4) ---
# URL and anon/publishable key are designed to be public; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server only. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App config ---
DAILY_LIMIT_DEFAULT=20
EVAL_LEAK_THRESHOLD=0.10
EVAL_FALSE_BLOCK_THRESHOLD=0.10
